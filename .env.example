# Copy to .env and keep secrets local. Research and paper workflows need no keys.
ENVIRONMENT=development
SYMBOLS=BTC-EUR,ETH-EUR,SOL-EUR,LINK-EUR
TIMEFRAMES=1m,3m,5m,15m,30m,1h,2h,3h,4h,6h,8h,12h,1d,2d,3d,1W,1mo
EXECUTION_MODE=research
LIVE_TRADING_ENABLED=false

# Optional Telegram notifications. Secrets remain local and are always redacted.
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_SIGNALS=true
TELEGRAM_SEND_WATCHLIST=true
TELEGRAM_SEND_EXITS=true
TELEGRAM_SEND_RISK_ALERTS=true
TELEGRAM_SEND_SYSTEM_ALERTS=true
TELEGRAM_MIN_CONFIDENCE=60
TELEGRAM_MIN_REWARD_RISK=1.5
TELEGRAM_MAX_MESSAGES_PER_MINUTE=10
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=3
TELEGRAM_DRY_RUN=false

# Public-data enrichment (optional)
COINMARKETCAP_API_KEY=
BITVAVO_DATA_API_KEY=
BITVAVO_DATA_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
MEXC_API_KEY=
MEXC_DATA_API_SECRET=
EODHD_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT=
# Optional item-level indicator/fundamental providers. Missing credentials keep
# the corresponding registry items at DATA_PROVIDER_REQUIRED with NaN values.
DUNE_API_KEY=
COINPAPRIKA_API_KEY=
FMP_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
MARKETSTACK_API_KEY=
THETA_DATA_API_KEY=
FISCAL_API_KEY=
CURRENT_NEWS_API_KEY=
MARKETAUX_API_TOKEN=
OPENFIGI_API_KEY=
OPENEXCHANGERATES_APP_ID=
POLYGON_API_KEY=
DATABASE_URL=

# Continuous combinatorial research lab (optional overrides)
LAB_UNIVERSE_TARGET_SIZE=50
LAB_UNIVERSE_SCAN_LIMIT=100
LAB_MINIMUM_VOLUME_24H_EUR=10000000
LAB_MINIMUM_HISTORY_ROWS=500
LAB_CONFIRMATION_JOB_THRESHOLD=100000
LAB_MAXIMUM_GENERATION_ROWS=250000
LAB_MAXIMUM_RETRIES=3
# LAB_MAX_WORKERS defaults to max(1, logical CPU count - 2).
# LAB_MAX_WORKERS=4
# LAB_CPU_LIMIT=4
LAB_MEMORY_LIMIT_MB=4096
LAB_TRIAL_TIMEOUT_SECONDS=300
LAB_COMBINATION_TIMEOUT_SECONDS=3600
LAB_HEARTBEAT_SECONDS=10
LAB_LEADERBOARD_REFRESH_MINUTES=15
LAB_UNIVERSE_REFRESH_HOURS=24

# Live spot execution (must be separate, trade-only, IP-restricted credentials)
BITVAVO_TRADE_API_KEY=
BITVAVO_TRADE_API_SECRET=
BITVAVO_OPERATOR_ID=
BITVAVO_TRADE_KEY_SCOPE=trade-only
BITVAVO_IP_WHITELIST_CONFIRMED=false
BITVAVO_WITHDRAWAL_PERMISSION=false
MAXIMUM_LIVE_ORDER_EUR=
MAXIMUM_LIVE_TOTAL_EUR=
MAXIMUM_LIVE_OPEN_POSITIONS=1
MAXIMUM_LIVE_NEW_ORDERS_PER_DAY=1
LIVE_CANARY_ENABLED=false
LIVE_CANARY_AUTOSCALE=false
MANUAL_APPROVAL_PHRASE=

# Practical governance and automatic paper lifecycle. Academic tests affect
# confidence/scaling, while integrity, net edge and operational safety fail closed.
GOVERNANCE_PRACTICAL_ENABLED=true
GOVERNANCE_ACADEMIC_TESTS_ARE_WARNINGS_FOR_CANARY=true
GOVERNANCE_MINIMUM_POSITIVE_PROFIT_FACTOR=1.0
GOVERNANCE_MINIMUM_CANARY_PROFIT_FACTOR=1.10
RESEARCH_MINIMUM_TRADES=100
RESEARCH_MINIMUM_HISTORY_DAYS=2557
PAPER_AUTOTRADE_ENABLED=true
PAPER_AUTO_PROMOTION_FROM_RESEARCH_POSITIVE=true
PAPER_MAX_OPEN_POSITIONS=5
PAPER_MAX_NEW_ORDERS_PER_DAY=10
PAPER_MAX_TOTAL_EXPOSURE_PCT=100
PAPER_MAX_RISK_PER_TRADE_PCT=0.50
PAPER_MAX_DAILY_LOSS_PCT=3.00
PAPER_MAX_DRAWDOWN_PCT=10.00

# Permanent top-50 research/paper/canary orchestrator. Live promotion remains
# human-approved per frozen strategy DNA.
AUTOPILOT_ENABLED=true
AUTOPILOT_TOP50_ENABLED=true
AUTOPILOT_MAX_NEW_STRATEGIES_PER_DAY=100
AUTOPILOT_MAX_PARAMETER_VARIANTS_PER_STRATEGY=50
AUTOPILOT_MAX_TOTAL_BACKTESTS_PER_DAY=2500
AUTOPILOT_MAX_RUNTIME_MINUTES_PER_CYCLE=180
AUTOPILOT_MIN_CYCLE_INTERVAL_HOURS=4
AUTOPILOT_EXECUTION_CYCLE_SECONDS=300
AUTOPILOT_WINDOWS_TASK_NAME=CryptoPracticalAutopilot
AUTOPILOT_MAX_DISK_GB=100
AUTOPILOT_MAX_FAILURES_PER_CYCLE=100
AUTOPILOT_AUTO_PAPER_PROMOTION=true
AUTOPILOT_AUTO_LIVE_PROMOTION=false

# Aspirational target only. The default is 0.5% of marked equity (EUR 250 at
# EUR 50,000; EUR 0.25 at EUR 50). It scales linearly and it never
# forces trades, changes sizing, relaxes stops or overrides risk controls.
DAILY_PROFIT_TARGET_ENABLED=true
DAILY_PROFIT_TARGET_REFERENCE_EQUITY_EUR=50000
DAILY_PROFIT_TARGET_REFERENCE_TARGET_EUR=250
DAILY_PROFIT_TARGET_FORCE_TRADES=false
DAILY_PROFIT_TARGET_OVERRIDE_RISK_LIMITS=false

AUTONOMOUS_LIVE_MARKETS=BTC-EUR,ETH-EUR,SOL-EUR,LINK-EUR,TAO-EUR,NPC-EUR
AUTONOMOUS_LIVE_RECONCILIATION_SECONDS=30
AUTONOMOUS_LIVE_EXECUTION_CYCLE_SECONDS=300
AUTONOMOUS_LIVE_ACTIVE_TRADING_SCAN_MINUTES=5
AUTONOMOUS_LIVE_ACTIVE_TRADING_POLL_SECONDS=30
AUTONOMOUS_LIVE_ACTIVE_TRADING_MAXIMUM_ROWS=1500
AUTONOMOUS_LIVE_HEALTH_SECONDS=10
AUTONOMOUS_LIVE_INTENSIVE_MARKET_LIMIT=35
AUTONOMOUS_LIVE_INTENSIVE_MOVER_SLOTS=20
AUTONOMOUS_LIVE_INTENSIVE_ROTATION_SECONDS=10
AUTONOMOUS_LIVE_WEBSOCKET_QUEUE_SIZE=2000
AUTONOMOUS_LIVE_MAXIMUM_RISK_PER_TRADE_PCT=0.25
AUTONOMOUS_LIVE_MAXIMUM_TOTAL_OPEN_RISK_PCT=1.00
AUTONOMOUS_LIVE_MAXIMUM_ASSET_EXPOSURE_PCT=25.00
AUTONOMOUS_LIVE_MAXIMUM_TOTAL_CRYPTO_EXPOSURE_PCT=80.00
AUTONOMOUS_LIVE_MINIMUM_CASH_RESERVE_PCT=20.00
AUTONOMOUS_LIVE_DAILY_LOSS_LIMIT_PCT=1.50
AUTONOMOUS_LIVE_SOFT_DRAWDOWN_PCT=3.00
AUTONOMOUS_LIVE_HARD_DRAWDOWN_PCT=7.50
AUTONOMOUS_LIVE_MAXIMUM_CONSECUTIVE_LOSSES=5
AUTONOMOUS_LIVE_MAXIMUM_ORDERS_PER_MARKET_PER_HOUR=4
AUTONOMOUS_LIVE_MAXIMUM_PORTFOLIO_ORDERS_PER_HOUR=10
AUTONOMOUS_LIVE_LIVE_CANARY_ORDER_EUR=10
AUTONOMOUS_LIVE_LIVE_CANARY_MAX_POSITION_EUR=15
AUTONOMOUS_LIVE_LIVE_REDUCED_MAX_POSITION_PCT=0.50
AUTONOMOUS_LIVE_LIVE_ACTIVE_MAX_POSITION_PCT=1.00
AUTONOMOUS_LIVE_MAXIMUM_VISIBLE_LIQUIDITY_PARTICIPATION_PCT=2.00
AUTONOMOUS_LIVE_BTC_MAXIMUM_SPREAD_BPS=20
AUTONOMOUS_LIVE_ETH_MAXIMUM_SPREAD_BPS=25
AUTONOMOUS_LIVE_TAO_MAXIMUM_SPREAD_BPS=75
AUTONOMOUS_LIVE_NPC_MAXIMUM_SPREAD_BPS=150
AUTONOMOUS_LIVE_BTC_MAXIMUM_SLIPPAGE_BPS=20
AUTONOMOUS_LIVE_ETH_MAXIMUM_SLIPPAGE_BPS=25
AUTONOMOUS_LIVE_TAO_MAXIMUM_SLIPPAGE_BPS=75
AUTONOMOUS_LIVE_NPC_MAXIMUM_SLIPPAGE_BPS=150
AUTONOMOUS_LIVE_BTC_MINIMUM_VISIBLE_ASK_DEPTH_EUR=5000
AUTONOMOUS_LIVE_ETH_MINIMUM_VISIBLE_ASK_DEPTH_EUR=5000
AUTONOMOUS_LIVE_TAO_MINIMUM_VISIBLE_ASK_DEPTH_EUR=500
AUTONOMOUS_LIVE_NPC_MINIMUM_VISIBLE_ASK_DEPTH_EUR=100
AUTONOMOUS_LIVE_BTC_MINIMUM_24H_QUOTE_VOLUME_EUR=1000000
AUTONOMOUS_LIVE_ETH_MINIMUM_24H_QUOTE_VOLUME_EUR=1000000
AUTONOMOUS_LIVE_TAO_MINIMUM_24H_QUOTE_VOLUME_EUR=100000
AUTONOMOUS_LIVE_NPC_MINIMUM_24H_QUOTE_VOLUME_EUR=10000
AUTONOMOUS_LIVE_DYNAMIC_MAXIMUM_SPREAD_BPS=75
AUTONOMOUS_LIVE_DYNAMIC_MAXIMUM_SLIPPAGE_BPS=75
AUTONOMOUS_LIVE_DYNAMIC_MINIMUM_VISIBLE_ASK_DEPTH_EUR=500
AUTONOMOUS_LIVE_DYNAMIC_MINIMUM_24H_QUOTE_VOLUME_EUR=100000

# Causal HMM regime controller. V1 is deliberately observer-only: it may
# analyse and compare risk multipliers but has no order or promotion authority.
HMM_ENABLED=true
HMM_OBSERVER_ONLY=true
HMM_RANDOM_SEED=20260727
HMM_COVARIANCE_TYPE=diag
HMM_MAXIMUM_ITERATIONS=250
HMM_CONVERGENCE_TOLERANCE=0.0001
HMM_MAXIMUM_TRAINING_OBSERVATIONS=4000
HMM_REFIT_INTERVAL_15M=672
HMM_REFIT_INTERVAL_1H=168
HMM_REFIT_INTERVAL_4H=42
HMM_REFIT_INTERVAL_1D=30
HMM_REFIT_INTERVAL_1W=13
HMM_MAXIMUM_TOTAL_EXPOSURE=0.40
HMM_MAXIMUM_ASSET_EXPOSURE=0.20
HMM_MINIMUM_CASH_FRACTION=0.60

LIVE_MAX_ORDER_EUR=10
LIVE_MAX_TOTAL_EXPOSURE_EUR=10
LIVE_MAX_OPEN_POSITIONS=1
LIVE_MAX_NEW_ORDERS_PER_DAY=1
LIVE_MAX_RISK_PER_TRADE_EUR=2
LIVE_MAX_DAILY_LOSS_EUR=5
LIVE_MAX_DRAWDOWN_EUR=10
LIVE_LIMIT_ENTRIES_ENABLED=true
# IOC consumes immediately available liquidity and cancels the remainder;
# GTC is intentionally not permitted for autonomous entries.
LIVE_LIMIT_ENTRY_TIME_IN_FORCE=GTC
LIVE_LIMIT_PRICE_BUFFER_BPS=1
LIVE_LIMIT_ENTRY_VALIDITY_SECONDS=90
LIVE_LIMIT_ENTRY_MAX_REPRICES=1
# At the exact EUR 10 canary cap a venue-compliant base amount can be
# impossible after tick/quantity rounding. In that case retain the existing
# quote-denominated market order, still protected by liquidity preflight.
LIVE_LIMIT_MARKET_FALLBACK_ENABLED=false

# Supported legacy aliases: VENUE_A_API_KEY, VENUE_A_API_SECRET,
# VENUE_B_API_KEY, VENUE_B_API_SECRET, CMC_API_KEY, WM_OPERATOR_ID.
