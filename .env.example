# Copy to .env and keep secrets local. Research and paper workflows need no keys.
ENVIRONMENT=development
SYMBOLS=BTC-EUR,ETH-EUR,SOL-EUR,LINK-EUR
TIMEFRAMES=1h,4h,1d
EXECUTION_MODE=research
LIVE_TRADING_ENABLED=false

# Public-data enrichment (optional)
COINMARKETCAP_API_KEY=
BITVAVO_DATA_API_KEY=
BITVAVO_DATA_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
MEXC_API_KEY=
MEXC_DATA_API_SECRET=
EODHD_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT=
# Optional item-level indicator/fundamental providers. Missing credentials keep
# the corresponding registry items at DATA_PROVIDER_REQUIRED with NaN values.
DUNE_API_KEY=
COINPAPRIKA_API_KEY=
FMP_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
MARKETSTACK_API_KEY=
THETA_DATA_API_KEY=
FISCAL_API_KEY=
CURRENT_NEWS_API_KEY=
MARKETAUX_API_TOKEN=
OPENFIGI_API_KEY=
OPENEXCHANGERATES_APP_ID=
POLYGON_API_KEY=
DATABASE_URL=

# Continuous combinatorial research lab (optional overrides)
LAB_UNIVERSE_TARGET_SIZE=25
LAB_UNIVERSE_SCAN_LIMIT=100
LAB_MINIMUM_VOLUME_24H_EUR=10000000
LAB_MINIMUM_HISTORY_ROWS=500
LAB_CONFIRMATION_JOB_THRESHOLD=100000
LAB_MAXIMUM_GENERATION_ROWS=250000
LAB_MAXIMUM_RETRIES=3
# LAB_MAX_WORKERS defaults to max(1, logical CPU count - 2).
# LAB_MAX_WORKERS=4
# LAB_CPU_LIMIT=4
LAB_MEMORY_LIMIT_MB=4096
LAB_TRIAL_TIMEOUT_SECONDS=300
LAB_COMBINATION_TIMEOUT_SECONDS=3600
LAB_HEARTBEAT_SECONDS=10
LAB_LEADERBOARD_REFRESH_MINUTES=15
LAB_UNIVERSE_REFRESH_HOURS=24

# Live spot execution (must be separate, trade-only, IP-restricted credentials)
BITVAVO_TRADE_API_KEY=
BITVAVO_TRADE_API_SECRET=
BITVAVO_OPERATOR_ID=
BITVAVO_TRADE_KEY_SCOPE=trade-only
BITVAVO_IP_WHITELIST_CONFIRMED=false
BITVAVO_WITHDRAWAL_PERMISSION=false
MAXIMUM_LIVE_ORDER_EUR=
MANUAL_APPROVAL_PHRASE=

# Supported legacy aliases: VENUE_A_API_KEY, VENUE_A_API_SECRET,
# VENUE_B_API_KEY, VENUE_B_API_SECRET, CMC_API_KEY, WM_OPERATOR_ID.
